Cell><mxCell id="note2" value="L’article du lot doit correspondre à l’article attendu. L’avis de chaque ligne doit être celui de la réception." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="754.0" width="1564.0" height="23" /></mxCell></root></mxGraphModel></diagram><diagram id="08-reserves-mouvements" name="08 - Réserves et journal des mouvements"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="1529" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="BD70 | Réserves et journal des mouvements" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="15" width="723.03" height="40" /></mxCell><mxCell id="legend" value="Identifiant souligné ; cardinalités de participation près de l’entité. Mêmes concepts dans toutes les vues." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="55" width="723.03" height="30" /></mxCell><mxCell id="location" value="&lt;b&gt;EMPLACEMENT&lt;/b&gt;&lt;hr&gt;&lt;u&gt;Identifiant&lt;/u&gt;&lt;br&gt;Code&lt;br&gt;Largeur (m)&lt;br&gt;Profondeur (m)&lt;br&gt;Hauteur (m)&lt;br&gt;Capacité (kg)&lt;br&gt;Capacité (éq. palettes)" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;shape=rectangle;rounded=0;fillColor=#eef4f9;strokeColor=#48647c;fontSize=15;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="56.27" y="100.0" width="164.9" height="242.0" /></mxCell><mxCell id="pick" value="&lt;b&gt;PRÉLÈVEMENT&lt;/b&gt;&lt;hr&gt;&lt;u&gt;Identifiant&lt;/u&gt;&lt;br&gt;Quantité&lt;br&gt;État&lt;br&gt;Confirmation (facultatif)" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColo