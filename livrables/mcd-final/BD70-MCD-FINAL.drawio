eSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=center;fontSize=14;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="559.08" y="555.42" width="40" height="20" /></mxCell><mxCell id="edge8" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#6c7d8c;strokeWidth=1.1;" edge="1" source="package" target="R55" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="736.62" y="230.0" /><mxPoint x="750.03" y="230.0" /></Array></mxGeometry></mxCell><mxCell id="card8tail" value="0,N" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=center;fontSize=14;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="722.08" y="131.55" width="40" height="20" /></mxCell><mxCell id="edge9" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#6c7d8c;strokeWidth=1.1;" edge="1" source="R55" target="pick" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="964.99" y="230.0" /><mxPoint x="978.43" y="230.0" /></Array></mxGeometry></mxCell><mxCell id="card9head" value="0,N" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=center;fontSize=14;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="953.24" y="131.55" width="40" height="20" /></mxCell><mxCell id="note0" value="La quantité appartient à l’association COLIS / PRÉLÈVEMENT : un prélèvement peut être réparti entre plusieurs colis." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="899.0" width="1120.3" height="23" /></mxCell><mxCell id="note1" value="Une commande a zéro ou une expédition (pas d’expédition partielle dans cette version). Un passage peut en charger plusieurs." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="922.0" width="1120.3" height="23" /></mxCell><mxCell id="note2" value="Avant chargement : même commande pour le colis et le prélèvement ; couverture exacte des quantités prélevées." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="945.0" width="1120.3" height="23" /></mxCell><mxCell id="note3" value="Bon de livraison et lettre de voiture sont générés à partir de ces faits, sans entités documentaires supplémentaires." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="968.0" width="1120.3" height="23" /></mxCell></root></mxGraphModel></diagram></mxfile>