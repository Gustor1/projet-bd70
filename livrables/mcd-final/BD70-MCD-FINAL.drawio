4;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="231.94" y="1308.53" width="40" height="20" /></mxCell><mxCell id="edge11" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#6c7d8c;strokeWidth=1.1;" edge="1" source="R50" target="receipt_reserve" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="508.07" y="1263.53" /><mxPoint x="580.01" y="1219.39" /></Array></mxGeometry></mxCell><mxCell id="card11head" value="0,1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=center;fontSize=14;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="580.84" y="1184.24" width="40" height="20" /></mxCell><mxCell id="edge12" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#6c7d8c;strokeWidth=1.1;" edge="1" source="user_account" target="R51" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="267.94" y="969.12" /><mxPoint x="301.28" y="977.99" /></Array></mxGeometry></mxCell><mxCell id="card12tail" value="0,N" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=center;fontSize=14;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="240.94" y="947.44" width="40" height="20" /></mxCell><mxCell id="edge13" style="edgeStyle=none;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#6c7d8c;strokeWidth=1.1;" edge="1" source="R51" target="receipt_reserve" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="500.3" y="1064.4" /><mxPoint x="577.61" y="1112.42" /></Array></mxGeometry></mxCell><mxCell id="card13head" value="1,1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=center;fontSize=14;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="581.75" y="1114.92" width="40" height="20" /></mxCell><mxCell id="note0" value="Contrainte XOR totale : une réserve vise exactement une réception OU une ligne, jamais les deux ni aucune." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="1408.9" width="1100" height="23" /></mxCell><mxCell id="note1" value="Un mouvement de sortie est lié à un prélèvement ; les autres mouvements ne le sont pas." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="1431.9" width="1100" height="23" /></mxCell><mxCell id="note2" value="Stock physique = somme des variations par fraction et emplacement. Un transfert comporte deux écritures opposées." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="1454.9" width="1100" height="23" /></mxCell><mxCell id="note3" value="Le texte d’avarie de la fraction (vue 7) complète les réserves structurées ; aucune quantité endommagée en stock disponible." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="1477.9" width="1100" height="23" /></mxCell></root></mxGraphModel></diagram><diagram id="09-commandes" name="09 - Commandes et préparation"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1659" pageHeight="1123" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="BD70 | Commandes et préparation" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="15" width="1579.0" height="40" /></mxCell><mxCell id="legend" value="Identifiant souligné ; cardinalités de participation près de l’entité. Mêmes concepts dans toutes les vues." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="55" width="1579.0" height="30" /></mxCell><mxCell id="article" value="&lt;b&gt;ARTICLE&lt;/b&gt;&lt;hr&gt;&lt;u&gt;Identifiant&lt;/u&gt;&lt;br&gt;Référence article&lt;br&gt;Nom&lt;br&gt;Condition de stockage&lt;br&gt;Conditionnement&lt;br&gt;Largeur (m)&lt;br&gt;Profondeur (m)&lt;br&gt;Hauteur (m)&lt;br&gt;Poids unitaire (kg)&lt;br&gt;Unités par palette" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;shape=rectangle;rounded=0;fillColor=#eef4f9;strokeColor=#48647c;fontSize=15;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="534.24" y="100.0" width="162.43" height="332.0" /></mxCell><mxCell id="customer_order" value="&lt;b&gt;COMMANDE&lt;/b&gt;&lt;hr&gt;&lt;u&gt;Identifiant&lt;/u&gt;&lt;br&gt;Référence&lt;br&gt;Adresse de livraison&lt;br&gt;Motif de reprise&lt;br&gt;Expédition souhaitée&lt;br&gt;État&lt;br&gt;Début de préparation (facultatif)&lt;br&gt;Fin de préparation (facultatif)" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;shape=rectangle;rounded=0;fillColor=#eef4f9;strokeColor=#48647c;fontSize=15;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="502.99" y="468.0" width="224.94" height="272.0" /></mxCell><mxCell id="location" value="&lt;b&gt;EMPLACEMENT&lt;/b&gt;&lt;hr&gt;&lt;u&gt;Identifiant&lt;/u&gt;&lt;br&gt;Code&lt;br&gt;Largeur (m)&lt;br&gt;Profondeur (m)&lt;br&gt;Hauteur (m)&lt;br&gt;Capacité (kg)&lt;br&gt;Capacité (éq. palettes)" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;shape=rectangle;rounded=0;fillColor=#eef4f9;strokeColor=#48647c;fontSize=15;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="994.05" y="741.0" width="164.9" height="242.0" /></mxCell><mxCell id="order_line" value="&lt;b&gt;LIGNE DE COMMANDE&lt;/b&gt;&lt;hr&gt;&lt;u&gt;Identifiant&lt;/u&gt;&lt;br&gt;Quantité" style="html