ry as="geometry" x="896.28" y="395.89" width="40" height="20" /></mxCell><mxCell id="note0" value="Un rendez-vous a exactement un quai, un chauffeur et un véhicule principal ; la remorque est facultative." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="732.92" width="1100" height="23" /></mxCell><mxCell id="note1" value="Un passage peut être sans rendez-vous ; un rendez-vous est lié à zéro ou un passage." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="755.92" width="1100" height="23" /></mxCell><mxCell id="note2" value="Les affectations prévues et constatées sont des faits distincts. Absence de chevauchement contrôlée par le service." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="778.92" width="1100" height="23" /></mxCell></root></mxGraphModel></diagram><diagram id="04-passages" name="04 - Passages réels et chronologie"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1218" pageHeight="955" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="BD70 | Passages réels et chronologie" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="15" width="1137.3" height="40" /></mxCell><mxCell id="legend" value="Identifiant souligné ; cardinalités de participation près de l’entité. Mêmes concepts dans toutes les vues." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#203c54;text;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="55" width="1137.3" height="30" /></mxCell><mxCell id="dock" value="&lt;b&gt;QUAI&lt;/b&gt;&lt;hr&gt;&lt