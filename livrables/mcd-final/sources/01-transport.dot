graph MCD {
graph [rankdir=LR, bgcolor="white", pad="0.32", nodesep="0.50", ranksep="0.55", splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=15, color="#48647c", penwidth=1.3];
edge [fontname="Arial", fontsize=14, color="#6c7d8c", fontcolor="#203c54", penwidth=1.1];
carrier [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#48647c"><TR><TD BGCOLOR="#e7eff6"><B>TRANSPORTEUR</B></TD></TR><TR><TD ALIGN="LEFT"><U>Identifiant</U></TD></TR><TR><TD ALIGN="LEFT">Code</TD></TR><TR><TD ALIGN="LEFT">Nom</TD></TR><TR><TD ALIGN="LEFT">Adresse</TD></TR><TR><TD ALIGN="LEFT">Téléphone</TD></TR><TR><TD ALIGN="LEFT">Email</TD></TR></TABLE>>];
carrier_contact [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#48647c"><TR><TD BGCOLOR="#e7eff6"><B>CONTACT</B></TD></TR><TR><TD ALIGN="LEFT"><U>Identifiant</U></TD></TR><TR><TD ALIGN="LEFT">Nom</TD></TR><TR><TD ALIGN="LEFT">Téléphone</TD></TR><TR><TD ALIGN="LEFT">Email</TD></TR></TABLE>>];
carrier_contract [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#48647c"><TR><TD BGCOLOR="#e7eff6"><B>CONTRAT</B></TD></TR><TR><TD ALIGN="LEFT"><U>Identifiant</U></TD></TR><TR><TD ALIGN="LEFT">Référence</TD></TR><TR><TD ALIGN="LEFT">Date de début</TD></TR><TR><TD ALIGN="LEFT">Date de fin</TD></TR><TR><TD ALIGN="LEFT">Conditions du contrat</TD></TR></TABLE>>];
driver [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#48647c"><TR><TD BGCOLOR="#e7eff6"><B>CHAUFFEUR</B></TD></TR><TR><TD ALIGN="LEFT"><U>Identifiant</U></TD></TR><TR><TD ALIGN="LEFT">Nom</TD></TR><TR><TD ALIGN="LEFT">Téléphone</TD></TR><TR><TD ALIGN="LEFT">Numéro de permis</TD></TR></TABLE>>];
equipment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#48647c"><TR><TD BGCOLOR="#e7eff6"><B>ÉQUIPEMENT</B></TD></TR><TR><TD ALIGN="LEFT"><U>Identifiant</U></TD></TR><TR><TD ALIGN="LEFT">Code</TD></TR><TR><TD ALIGN="LEFT">Nom</TD></TR></TABLE>>];
qualification [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#48647c"><TR><TD BGCOLOR="#e7eff6"><B>HABILITATION</B></TD></TR><TR><TD ALIGN="LEFT"><U>Identifiant</U></TD></TR><TR><TD ALIGN="LEFT">Code</TD></TR><TR><TD ALIGN="LEFT">Nom</TD></TR></TABLE>>];
vehicle [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#48647c"><TR><TD BGCOLOR="#e7eff6"><B>VÉHICULE</B></TD></TR><TR><TD ALIGN="LEFT"><U>Identifiant</U></TD></TR><TR><TD ALIGN="LEFT">Immatriculation</TD></TR><TR><TD ALIGN="LEFT">Capacité (kg)</TD></TR><TR><TD ALIGN="LEFT">Capacité (éq. palettes)</TD></TR></TABLE>>];
R01 [shape=diamond, style=filled, fillcolor="#fff7e8", margin="0.12,0.08", fontsize=14, label="R01\npossède un\ncontact"];
carrier -- R01 [taillabel="0,N", labeldistance=2.0, labelangle=25];
R01 -- carrier_contact [headlabel="1,1", labeldistance=2.0, labelangle=-25];
R02 [shape=diamond, style=filled, fillcolor="#fff7e8", margin="0.12,0.08", fontsize=14, label="R02\nsigne un contrat"];
carrier -- R02 [taillabel="0,N", labeldistance=2.0, labelangle=25];
R02 -- carrier_contract [headlabel="1,1", labeldistance=2.0, labelangle=-25];
R03 [shape=diamond, style=filled, fillcolor="#fff7e8", margin="0.12,0.08", fontsize=14, label="R03\nrattache un\nchauffeur"];
carrier -- R03 [taillabel="0,N", labeldistance=2.0, labelangle=25];
R03 -- driver [headlabel="1,1", labeldistance=2.0, labelangle=-25];
R04 [shape=diamond, style=filled, fillcolor="#fff7e8", margin="0.12,0.08", fontsize=14, label="R04\nexploite un\nvéhicule"];
carrier -- R04 [taillabel="0,N", labeldistance=2.0, labelangle=25];
R04 -- vehicle [headlabel="1,1", labeldistance=2.0, labelangle=-25];
R52 [shape=diamond, style=filled, fillcolor="#fff7e8", margin="0.12,0.08", fontsize=14, label="R52\nest habilité\nDate de fin de\nvalidité"];
driver -- R52 [taillabel="0,N", labeldistance=2.0, labelangle=25];
R52 -- qualification [headlabel="0,N", labeldistance=2.0, labelangle=-25];
R53 [shape=diamond, style=filled, fillcolor="#fff7e8", margin="0.12,0.08", fontsize=14, label="R53\nest équipé de"];
vehicle -- R53 [taillabel="0,N", labeldistance=2.0, labelangle=25];
R53 -- equipment [headlabel="0,N", labeldistance=2.0, labelangle=-25];
}