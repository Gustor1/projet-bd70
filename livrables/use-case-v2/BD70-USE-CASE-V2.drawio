        <mxCell id="include" value="« include » : le cas source exécute obligatoirement le comportement inclus ; la flèche pointe vers ce comportement." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1580" width="2260" height="35" />
        </mxCell>
        <mxCell id="extend" value="« extend » : un comportement complète le cas de base sous une condition ; la flèche pointe vers le cas de base." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1630" width="2260" height="35" />
        </mxCell>
        <mxCell id="documents-note" value="Les documents de transport peuvent être consultés / imprimés séparément : aucune inclusion automatique depuis « charger » n’est imposée." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1680" width="2260" height="35" />
        </mxCell>
        <mxCell id="fefo-note" value="FEFO : les lots dont la date de péremption arrive en premier sont prélevés en priorité. Les étapes de travail sont détaillées dans les scénarios." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
