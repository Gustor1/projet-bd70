        <mxCell id="legend-title" value="Lecture du diagramme" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="350" y="1840" width="1310" height="30" />
        </mxCell>
        <mxCell id="leg0" value="Un acteur = un rôle : chaque acteur est dessiné une seule fois et relié" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="1880" width="1290" height="32" />
        </mxCell>
        <mxCell id="leg1" value="aux seuls cas qu’il réalise. Aucun héritage entre acteurs." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="1934" width="1290" height="32" />
        </mxCell>
        <mxCell id="leg2" value="Le responsable coordonne et affecte ; le magasinier / préparateur exécute" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="1988" width="1290" height="32" />
        </mxCell>
        <mxCell id="leg3" value="les commandes qui lui sont affectées ; l’administrateur gère les comptes." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="2042" width="1290" height="32" />
        </mxCell>
        <mxCell id="leg4" value="Le transporteur planifie uniquement les rendez-vous de sa société." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="2096" width="1290" height="32" />
        </mxCell>
        <mxCell id="leg5" value="« include » : comportement systématique ; la flèche pointe vers le cas inclus." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="2150" width="1290" height="32" />
        </mxCell>
        <mxCell id="leg6" value="« extend » : complément conditionnel [condition] ; la flèche pointe vers le cas de base." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="2204" width="1290" height="32" />
        </mxCell>
        <mxCell id="leg7" value="Tous les cas métier exigent une session ; ils sont implémentés dans l’interface web." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#20354b;strokeColor=#20354b;strokeWidth=2;fillColor=none;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="2258" width="1290" height="32" />
        </mxCell>
