digraph MLD {
rankdir=LR;
graph [fontname="Arial",bgcolor="white",pad="0.4",nodesep="0.6",ranksep="1",splines=polyline]; node [fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=10,color="#617b94",fontcolor="#17324d"];
audit_log [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>audit_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">bigint(20)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">entity</TD><TD ALIGN="LEFT">varchar(50)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">entity_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">operation</TD><TD ALIGN="LEFT">varchar(12)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK actor_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">happened_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">details</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR></TABLE>>];
location [shape=box,style="rounded,dashed",label="Emplacements\nlocation",color="#a0aab5"];
pick [shape=box,style="rounded,dashed",label="Prélèvements\npick",color="#a0aab5"];
receipt_item [shape=box,style="rounded,dashed",label="Palettes reçues\nreceipt_item",color="#a0aab5"];
site_lock [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>site_lock</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">label</TD><TD ALIGN="LEFT">varchar(80)</TD><TD>NN</TD></TR></TABLE>>];
stock_movement [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>stock_movement</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">operation_ref</TD><TD ALIGN="LEFT">varchar(64)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK receipt_item_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK location_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">delta</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">enum(&#x27;entry&#x27;,&#x27;transfer&#x27;,&#x27;shipment&#x27;,&#x27;adjustment&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK pick_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK actor_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (pick_id)</TD></TR></TABLE>>];
truck_visit [shape=box,style="rounded,dashed",label="Passages camions\ntruck_visit",color="#a0aab5"];
user_account [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>user_account</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(190)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">enum(&#x27;pending&#x27;,&#x27;admin&#x27;,&#x27;manager&#x27;,&#x27;gate&#x27;,&#x27;warehouse&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">tinyint(1)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (email)</TD></TR></TABLE>>];
visit_event [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>visit_event</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK visit_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT">enum(&#x27;arrived&#x27;,&#x27;checked&#x27;,&#x27;parking&#x27;,&#x27;called&#x27;,&#x27;working&#x27;,&#x27;finished&#x27;,&#x27;departed&#x27;,&#x27;rejected&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">happened_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK actor_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (visit_id, state)</TD></TR></TABLE>>];
audit_log -> user_account [label="actor_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
stock_movement -> receipt_item [label="receipt_item_id",taillabel="0..N",headlabel="1",labeldistance=2];
stock_movement -> location [label="location_id",taillabel="0..N",headlabel="1",labeldistance=2];
stock_movement -> pick [label="pick_id",taillabel="0..1",headlabel="0..1",labeldistance=2];
stock_movement -> user_account [label="actor_id",taillabel="0..N",headlabel="1",labeldistance=2];
visit_event -> truck_visit [label="visit_id",taillabel="0..N",headlabel="1",labeldistance=2];
visit_event -> user_account [label="actor_id",taillabel="0..N",headlabel="1",labeldistance=2];
}