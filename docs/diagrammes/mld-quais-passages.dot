digraph MLD {
rankdir=LR;
graph [fontname="Arial",bgcolor="white",pad="0.4",nodesep="0.6",ranksep="1",splines=polyline]; node [fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=10,color="#617b94",fontcolor="#17324d"];
appointment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>appointment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">varchar(40)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK dock_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK driver_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK vehicle_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK trailer_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">operation</TD><TD ALIGN="LEFT">enum(&#x27;reception&#x27;,&#x27;expedition&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">starts_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ends_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">enum(&#x27;active&#x27;,&#x27;cancelled&#x27;)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (reference)</TD></TR></TABLE>>];
carrier [shape=box,style="rounded,dashed",label="Transporteurs\ncarrier",color="#a0aab5"];
dock [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>dock</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">enum(&#x27;reception&#x27;,&#x27;expedition&#x27;,&#x27;mixte&#x27;)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
dock_downtime [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>dock_downtime</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK dock_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">starts_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ends_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR></TABLE>>];
dock_equipment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>dock_equipment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK dock_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK equipment_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (dock_id, equipment_id)</TD></TR></TABLE>>];
dock_vehicle_type [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>dock_vehicle_type</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK dock_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">vehicle_type</TD><TD ALIGN="LEFT">enum(&#x27;tracteur&#x27;,&#x27;remorque&#x27;,&#x27;porteur&#x27;,&#x27;fourgon&#x27;)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (dock_id, vehicle_type)</TD></TR></TABLE>>];
driver [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>driver</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK carrier_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">license_number</TD><TD ALIGN="LEFT">varchar(60)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (license_number)</TD></TR></TABLE>>];
equipment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>equipment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
truck_visit [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>truck_visit</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">varchar(40)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK appointment_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">FK driver_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK vehicle_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK trailer_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">operation</TD><TD ALIGN="LEFT">enum(&#x27;reception&#x27;,&#x27;expedition&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK dock_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">enum(&#x27;arrived&#x27;,&#x27;checked&#x27;,&#x27;parking&#x27;,&#x27;called&#x27;,&#x27;working&#x27;,&#x27;finished&#x27;,&#x27;departed&#x27;,&#x27;rejected&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">document_note</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (reference)</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (appointment_id)</TD></TR></TABLE>>];
user_account [shape=box,style="rounded,dashed",label="Utilisateurs\nuser_account",color="#a0aab5"];
vehicle [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>vehicle</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK carrier_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">plate</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">enum(&#x27;tracteur&#x27;,&#x27;remorque&#x27;,&#x27;porteur&#x27;,&#x27;fourgon&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">max_kg</TD><TD ALIGN="LEFT">decimal(12,3)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">max_pallets</TD><TD ALIGN="LEFT">decimal(10,3)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (plate)</TD></TR></TABLE>>];
visit_event [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>visit_event</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK visit_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT">enum(&#x27;arrived&#x27;,&#x27;checked&#x27;,&#x27;parking&#x27;,&#x27;called&#x27;,&#x27;working&#x27;,&#x27;finished&#x27;,&#x27;departed&#x27;,&#x27;rejected&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">happened_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK actor_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (visit_id, state)</TD></TR></TABLE>>];
dock_equipment -> dock [label="dock_id",taillabel="0..N",headlabel="1",labeldistance=2];
dock_equipment -> equipment [label="equipment_id",taillabel="0..N",headlabel="1",labeldistance=2];
dock_vehicle_type -> dock [label="dock_id",taillabel="0..N",headlabel="1",labeldistance=2];
dock_downtime -> dock [label="dock_id",taillabel="0..N",headlabel="1",labeldistance=2];
appointment -> dock [label="dock_id",taillabel="0..N",headlabel="1",labeldistance=2];
appointment -> driver [label="driver_id",taillabel="0..N",headlabel="1",labeldistance=2];
appointment -> vehicle [label="vehicle_id",taillabel="0..N",headlabel="1",labeldistance=2];
appointment -> vehicle [label="trailer_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
truck_visit -> appointment [label="appointment_id",taillabel="0..1",headlabel="0..1",labeldistance=2];
truck_visit -> driver [label="driver_id",taillabel="0..N",headlabel="1",labeldistance=2];
truck_visit -> vehicle [label="vehicle_id",taillabel="0..N",headlabel="1",labeldistance=2];
truck_visit -> vehicle [label="trailer_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
truck_visit -> dock [label="dock_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
visit_event -> truck_visit [label="visit_id",taillabel="0..N",headlabel="1",labeldistance=2];
visit_event -> user_account [label="actor_id",taillabel="0..N",headlabel="1",labeldistance=2];
driver -> carrier [label="carrier_id",taillabel="0..N",headlabel="1",labeldistance=2];
vehicle -> carrier [label="carrier_id",taillabel="0..N",headlabel="1",labeldistance=2];
}