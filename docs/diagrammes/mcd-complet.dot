graph MCD {
rankdir=LR;
graph [fontname="Arial",bgcolor="white",pad="0.4",nodesep="0.6",ranksep="1",splines=polyline]; node [fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=10,color="#617b94",fontcolor="#17324d"];
aisle [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Allées\nCode"];
appointment [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Rendez-vous\nRéférence\nOpération\nDébut\nFin"];
article [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Articles\nRéférence article\nNom\nCondition de stockage\nConditionnement"];
carrier [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Transporteurs\nCode\nNom\nAdresse\nTéléphone"];
carrier_contact [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Contacts transporteurs\nNom\nTéléphone\nEmail"];
carrier_contract [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Contrats\nRéférence\nDate de début\nDate de fin\nConditions du contrat"];
customer_order [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Commandes\nRéférence\nAdresse de livraison\nExpédition souhaitée\nÉtat"];
dock [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Quais\nCode\nNom\nType"];
dock_downtime [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Indisponibilités\nDébut\nFin\nMotif"];
dock_vehicle_type [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Compatibilités des quais\nType de véhicule"];
driver [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Chauffeurs\nNom\nTéléphone\nNuméro de permis"];
equipment [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Équipements\nCode\nNom"];
location [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Emplacements\nCode\nLargeur (m)\nProfondeur (m)\nHauteur (m)"];
lot [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Lots\nCode\nDate limite / validité\nLot bloqué\nMotif du blocage"];
notice_line [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Lignes attendues\nQuantité attendue"];
order_line [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Lignes de commande\nQuantité"];
owner [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Clients propriétaires\nCode\nNom\nAdresse\nEmail"];
package [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Colis et palettes de sortie\nCode\nType"];
pick [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Prélèvements\nQuantité\nÉtat\nConfirmation"];
qualification [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Habilitations\nCode\nNom"];
rack [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Racks\nCode"];
rack_level [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Niveaux\nCode"];
receipt [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Réceptions\nRéférence\nÉtat\nValidation"];
receipt_item [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Palettes reçues\nCode palette / fraction\nQuantité acceptée\nQuantité endommagée\nÉtat de palette"];
receipt_line [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Lignes de réception\nQuantité attendue"];
shipment [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Expéditions\nRéférence\nExpédition"];
stock_movement [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Mouvements de stock\nOpération liée\nVariation (unités)\nNature\nMotif"];
supplier [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Fournisseurs\nCode\nNom\nAdresse\nTéléphone"];
