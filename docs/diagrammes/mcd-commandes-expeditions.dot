graph MCD {
rankdir=LR;
graph [fontname="Arial",bgcolor="white",pad="0.4",nodesep="0.6",ranksep="1",splines=polyline]; node [fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=10,color="#617b94",fontcolor="#17324d"];
customer_order [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Commandes\nRéférence\nAdresse de livraison\nMotif de reprise\nExpédition souhaitée"];
location [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Emplacements\nCode\nLargeur (m)\nProfondeur (m)\nHauteur (m)"];
order_line [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Lignes de commande\nQuantité"];
package [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Colis et palettes de sortie\nCode\nType"];
pick [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Prélèvements\nQuantité\nÉtat\nConfirmation"];
receipt_item [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Palettes reçues\nCode palette / fraction\nQuantité acceptée\nQuantité endommagée\nÉtat de palette"];
shipment [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Expéditions\nRéférence\nExpédition"];
truck_visit [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Passages camions\nRéférence\nOpération\nÉtat\nContrôle documentaire / observations"];
user_account [shape=box,style="rounded,filled",fillcolor="#edf4fa",color="#5b82a6",label="Utilisateurs\nEmail\nNom\nProfil\nCompte actif"];
assoc36 [shape=diamond,fontsize=10,label="rangement initial",color="#7693ad"];location -- assoc36 [taillabel="0..N",labeldistance=2];assoc36 -- receipt_item [headlabel="1",labeldistance=2];
assoc41 [shape=diamond,fontsize=10,label="prépare",color="#7693ad"];user_account -- assoc41 [taillabel="0..N",labeldistance=2];assoc41 -- customer_order [headlabel="0..1",labeldistance=2];
assoc42 [shape=diamond,fontsize=10,label="détaille",color="#7693ad"];customer_order -- assoc42 [taillabel="0..N",labeldistance=2];assoc42 -- order_line [headlabel="1",labeldistance=2];
assoc44 [shape=diamond,fontsize=10,label="est servie (quantité)",color="#7693ad"];order_line -- assoc44 [taillabel="0..N",labeldistance=2];assoc44 -- pick [headlabel="1",labeldistance=2];
assoc45 [shape=diamond,fontsize=10,label="fournit le lot reçu",color="#7693ad"];receipt_item -- assoc45 [taillabel="0..N",labeldistance=2];assoc45 -- pick [headlabel="1",labeldistance=2];
assoc46 [shape=diamond,fontsize=10,label="est prélevé à",color="#7693ad"];location -- assoc46 [taillabel="0..N",labeldistance=2];assoc46 -- pick [headlabel="1",labeldistance=2];
assoc47 [shape=diamond,fontsize=10,label="est conditionnée",color="#7693ad"];customer_order -- assoc47 [taillabel="0..N",labeldistance=2];assoc47 -- package [headlabel="1",labeldistance=2];
assoc48 [shape=diamond,fontsize=10,label="contient (quantité affectée)",color="#7693ad"];package -- assoc48 [taillabel="0..N",labeldistance=2];assoc48 -- pick [headlabel="0..N",labeldistance=2];
assoc49 [shape=diamond,fontsize=10,label="est expédiée",color="#7693ad"];customer_order -- assoc49 [taillabel="0..1",labeldistance=2];assoc49 -- shipment [headlabel="1",labeldistance=2];
assoc50 [shape=diamond,fontsize=10,label="charge",color="#7693ad"];truck_visit -- assoc50 [taillabel="0..N",labeldistance=2];assoc50 -- shipment [headlabel="1",labeldistance=2];
}