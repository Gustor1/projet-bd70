digraph MLD {
rankdir=LR;
graph [fontname="Arial",bgcolor="white",pad="0.4",nodesep="0.6",ranksep="1",splines=polyline]; node [fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=10,color="#617b94",fontcolor="#17324d"];
aisle [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>aisle</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK zone_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
article [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>article</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK owner_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">sku</TD><TD ALIGN="LEFT">varchar(40)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">storage</TD><TD ALIGN="LEFT">enum(&#x27;ambiant&#x27;,&#x27;froid&#x27;,&#x27;dangereux&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">packaging</TD><TD ALIGN="LEFT">varchar(80)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">width_m</TD><TD ALIGN="LEFT">decimal(10,4)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">depth_m</TD><TD ALIGN="LEFT">decimal(10,4)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">height_m</TD><TD ALIGN="LEFT">decimal(10,4)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">unit_kg</TD><TD ALIGN="LEFT">decimal(10,3)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">units_per_pallet</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (owner_id, sku)</TD></TR></TABLE>>];
location [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>location</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK level_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">width_m</TD><TD ALIGN="LEFT">decimal(10,4)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">depth_m</TD><TD ALIGN="LEFT">decimal(10,4)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">height_m</TD><TD ALIGN="LEFT">decimal(10,4)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">max_kg</TD><TD ALIGN="LEFT">decimal(12,3)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">max_pallets</TD><TD ALIGN="LEFT">decimal(10,3)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
lot [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>lot</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK article_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(40)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">expires_on</TD><TD ALIGN="LEFT">date</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">blocked</TD><TD ALIGN="LEFT">tinyint(1)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">block_reason</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (article_id, code)</TD></TR></TABLE>>];
notice_line [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>notice_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK notice_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK article_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">expected_qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (notice_id, article_id)</TD></TR></TABLE>>];
owner [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>owner</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(190)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
pick [shape=box,style="rounded,dashed",label="Prélèvements\npick",color="#a0aab5"];
rack [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>rack</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK aisle_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
rack_level [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>rack_level</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK rack_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
receipt [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>receipt</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">varchar(40)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK notice_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK visit_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">enum(&#x27;draft&#x27;,&#x27;validated&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">validated_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NULL</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (reference)</TD></TR></TABLE>>];
receipt_item [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>receipt_item</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK line_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK lot_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">pallet_code</TD><TD ALIGN="LEFT">varchar(50)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">accepted_qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">damaged_qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">pallet_state</TD><TD ALIGN="LEFT">enum(&#x27;bon&#x27;,&#x27;abime&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reservation</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK location_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (pallet_code)</TD></TR></TABLE>>];
receipt_line [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>receipt_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK receipt_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK notice_line_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">expected_qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (receipt_id, notice_line_id)</TD></TR></TABLE>>];
receipt_reserve [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>receipt_reserve</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK receipt_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">FK line_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">enum(&#x27;manquant&#x27;,&#x27;excedent&#x27;,&#x27;avarie&#x27;,&#x27;autre&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK actor_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR></TABLE>>];
stock_balance [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>stock_balance</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK receipt_item_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">PK location_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reserved_qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR></TABLE>>];
stock_movement [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>stock_movement</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">operation_ref</TD><TD ALIGN="LEFT">varchar(64)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK receipt_item_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">FK location_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">delta</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">enum(&#x27;entry&#x27;,&#x27;transfer&#x27;,&#x27;shipment&#x27;,&#x27;adjustment&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK pick_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK actor_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (pick_id)</TD></TR></TABLE>>];
supplier [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>supplier</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
supplier_notice [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>supplier_notice</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">varchar(40)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK supplier_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">expected_on</TD><TD ALIGN="LEFT">date</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">closed_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">FK closed_by</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">closure_note</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (reference)</TD></TR></TABLE>>];
truck_visit [shape=box,style="rounded,dashed",label="Passages camions\ntruck_visit",color="#a0aab5"];
user_account [shape=box,style="rounded,dashed",label="Utilisateurs\nuser_account",color="#a0aab5"];
zone [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>zone</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">storage</TD><TD ALIGN="LEFT">enum(&#x27;ambiant&#x27;,&#x27;froid&#x27;,&#x27;dangereux&#x27;)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
supplier_notice -> user_account [label="closed_by",taillabel="0..N",headlabel="0..1",labeldistance=2];
supplier_notice -> supplier [label="supplier_id",taillabel="0..N",headlabel="1",labeldistance=2];
notice_line -> supplier_notice [label="notice_id",taillabel="0..N",headlabel="1",labeldistance=2];
notice_line -> article [label="article_id",taillabel="0..N",headlabel="1",labeldistance=2];
receipt -> supplier_notice [label="notice_id",taillabel="0..N",headlabel="1",labeldistance=2];
receipt -> truck_visit [label="visit_id",taillabel="0..N",headlabel="1",labeldistance=2];
receipt_line -> receipt [label="receipt_id",taillabel="0..N",headlabel="1",labeldistance=2];
receipt_line -> notice_line [label="notice_line_id",taillabel="0..N",headlabel="1",labeldistance=2];
