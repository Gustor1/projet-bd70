receipt_reserve -> receipt_line [label="line_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
receipt_reserve -> user_account [label="actor_id",taillabel="0..N",headlabel="1",labeldistance=2];
lot -> article [label="article_id",taillabel="0..N",headlabel="1",labeldistance=2];
article -> owner [label="owner_id",taillabel="0..N",headlabel="1",labeldistance=2];
aisle -> zone [label="zone_id",taillabel="0..N",headlabel="1",labeldistance=2];
rack -> aisle [label="aisle_id",taillabel="0..N",headlabel="1",labeldistance=2];
rack_level -> rack [label="rack_id",taillabel="0..N",headlabel="1",labeldistance=2];
location -> rack_level [label="level_id",taillabel="0..N",headlabel="1",labeldistance=2];
stock_movement -> receipt_item [label="receipt_item_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
stock_movement -> location [label="location_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
stock_movement -> pick [label="pick_id",taillabel="0..1",headlabel="0..1",labeldistance=2];
stock_movement -> user_account [label="actor_id",taillabel="0..N",headlabel="1",labeldistance=2];
stock_balance -> receipt_item [label="receipt_item_id",taillabel="0..N",headlabel="1",labeldistance=2];
stock_balance -> location [label="location_id",taillabel="0..N",headlabel="1",labeldistance=2];
}