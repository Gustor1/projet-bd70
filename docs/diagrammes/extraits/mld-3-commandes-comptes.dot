digraph MLD {
rankdir=LR;
graph [fontname="Arial",bgcolor="white",pad="0.4",nodesep="0.6",ranksep="1",splines=polyline]; node [fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=10,color="#617b94",fontcolor="#17324d"];
article [shape=box,style="rounded,dashed",label="Articles\narticle",color="#a0aab5"];
audit_log [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>audit_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">bigint(20)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">entity</TD><TD ALIGN="LEFT">varchar(50)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">entity_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">operation</TD><TD ALIGN="LEFT">varchar(12)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK actor_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">happened_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">details</TD><TD ALIGN="LEFT">text</TD><TD>NN</TD></TR></TABLE>>];
carrier [shape=box,style="rounded,dashed",label="Transporteurs\ncarrier",color="#a0aab5"];
customer_order [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>customer_order</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">varchar(40)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK owner_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">destination</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">revision_note</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">desired_on</TD><TD ALIGN="LEFT">date</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">enum(&#x27;draft&#x27;,&#x27;picking&#x27;,&#x27;ready&#x27;,&#x27;shipped&#x27;,&#x27;cancelled&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK preparer_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">picking_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">ready_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NULL</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (reference)</TD></TR></TABLE>>];
location [shape=box,style="rounded,dashed",label="Emplacements\nlocation",color="#a0aab5"];
order_line [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>order_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK order_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK article_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (order_id, article_id)</TD></TR></TABLE>>];
owner [shape=box,style="rounded,dashed",label="Clients propriétaires\nowner",color="#a0aab5"];
package [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>package</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK order_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(50)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">enum(&#x27;colis&#x27;,&#x27;palette&#x27;)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
package_pick [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>package_pick</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK package_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK pick_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (package_id, pick_id)</TD></TR></TABLE>>];
pick [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>pick</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK order_line_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK receipt_item_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK location_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">enum(&#x27;planned&#x27;,&#x27;confirmed&#x27;,&#x27;shipped&#x27;,&#x27;cancelled&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">confirmed_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NULL</TD></TR></TABLE>>];
receipt_item [shape=box,style="rounded,dashed",label="Palettes reçues\nreceipt_item",color="#a0aab5"];
shipment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>shipment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK order_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK visit_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">varchar(40)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">shipped_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK actor_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (order_id)</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (reference)</TD></TR></TABLE>>];
site_lock [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>site_lock</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">label</TD><TD ALIGN="LEFT">varchar(80)</TD><TD>NN</TD></TR></TABLE>>];
truck_visit [shape=box,style="rounded,dashed",label="Passages camions\ntruck_visit",color="#a0aab5"];
user_account [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>user_account</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(190)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">enum(&#x27;pending&#x27;,&#x27;admin&#x27;,&#x27;manager&#x27;,&#x27;gate&#x27;,&#x27;warehouse&#x27;,&#x27;carrier&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">tinyint(1)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK carrier_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (email)</TD></TR></TABLE>>];
customer_order -> owner [label="owner_id",taillabel="0..N",headlabel="1",labeldistance=2];
customer_order -> user_account [label="preparer_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
order_line -> customer_order [label="order_id",taillabel="0..N",headlabel="1",labeldistance=2];
order_line -> article [label="article_id",taillabel="0..N",headlabel="1",labeldistance=2];
pick -> order_line [label="order_line_id",taillabel="0..N",headlabel="1",labeldistance=2];
pick -> receipt_item [label="receipt_item_id",taillabel="0..N",headlabel="1",labeldistance=2];
pick -> location [label="location_id",taillabel="0..N",headlabel="1",labeldistance=2];
package -> customer_order [label="order_id",taillabel="0..N",headlabel="1",labeldistance=2];
package_pick -> package [label="package_id",taillabel="0..N",headlabel="1",labeldistance=2];
package_pick -> pick [label="pick_id",taillabel="0..N",headlabel="1",labeldistance=2];
shipment -> customer_order [label="order_id",taillabel="0..1",headlabel="1",labeldistance=2];
shipment -> truck_visit [label="visit_id",taillabel="0..N",headlabel="1",labeldistance=2];
shipment -> user_account [label="actor_id",taillabel="0..N",headlabel="1",labeldistance=2];
user_account -> carrier [label="carrier_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
audit_log -> user_account [label="actor_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
}