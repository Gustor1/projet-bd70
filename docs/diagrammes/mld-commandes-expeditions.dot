digraph MLD {
rankdir=LR;
graph [fontname="Arial",bgcolor="white",pad="0.4",nodesep="0.6",ranksep="1",splines=polyline]; node [fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=10,color="#617b94",fontcolor="#17324d"];
appointment [shape=box,style="rounded,dashed",label="Rendez-vous\nappointment",color="#a0aab5"];
article [shape=box,style="rounded,dashed",label="Articles\narticle",color="#a0aab5"];
customer_order [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>customer_order</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">varchar(40)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK owner_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">destination</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">desired_on</TD><TD ALIGN="LEFT">date</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">enum(&#x27;draft&#x27;,&#x27;picking&#x27;,&#x27;ready&#x27;,&#x27;shipped&#x27;,&#x27;cancelled&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK preparer_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">picking_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">ready_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NULL</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (reference)</TD></TR></TABLE>>];
dock [shape=box,style="rounded,dashed",label="Quais\ndock",color="#a0aab5"];
driver [shape=box,style="rounded,dashed",label="Chauffeurs\ndriver",color="#a0aab5"];
location [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>location</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK level_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">width_m</TD><TD ALIGN="LEFT">decimal(10,4)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">depth_m</TD><TD ALIGN="LEFT">decimal(10,4)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">height_m</TD><TD ALIGN="LEFT">decimal(10,4)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">max_kg</TD><TD ALIGN="LEFT">decimal(12,3)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">max_pallets</TD><TD ALIGN="LEFT">decimal(10,3)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
lot [shape=box,style="rounded,dashed",label="Lots\nlot",color="#a0aab5"];
order_line [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>order_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK order_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK article_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (order_id, article_id)</TD></TR></TABLE>>];
owner [shape=box,style="rounded,dashed",label="Clients propriétaires\nowner",color="#a0aab5"];
package [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>package</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK order_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(50)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">enum(&#x27;colis&#x27;,&#x27;palette&#x27;)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
package_pick [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>package_pick</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK package_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK pick_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (pick_id)</TD></TR></TABLE>>];
pick [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>pick</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK order_line_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK receipt_item_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK location_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">enum(&#x27;planned&#x27;,&#x27;confirmed&#x27;,&#x27;shipped&#x27;,&#x27;cancelled&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">confirmed_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NULL</TD></TR></TABLE>>];
rack_level [shape=box,style="rounded,dashed",label="Niveaux\nrack_level",color="#a0aab5"];
receipt_item [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>receipt_item</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK line_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK lot_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">pallet_code</TD><TD ALIGN="LEFT">varchar(50)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">accepted_qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">damaged_qty</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">pallet_state</TD><TD ALIGN="LEFT">enum(&#x27;bon&#x27;,&#x27;abime&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reservation</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK location_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (pallet_code)</TD></TR></TABLE>>];
receipt_line [shape=box,style="rounded,dashed",label="Lignes de réception\nreceipt_line",color="#a0aab5"];
shipment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>shipment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK order_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK visit_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">varchar(40)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">shipped_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK actor_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (order_id)</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (reference)</TD></TR></TABLE>>];
truck_visit [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>truck_visit</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">varchar(40)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK appointment_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">FK driver_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK vehicle_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK trailer_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">operation</TD><TD ALIGN="LEFT">enum(&#x27;reception&#x27;,&#x27;expedition&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK dock_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">enum(&#x27;arrived&#x27;,&#x27;checked&#x27;,&#x27;parking&#x27;,&#x27;called&#x27;,&#x27;working&#x27;,&#x27;finished&#x27;,&#x27;departed&#x27;,&#x27;rejected&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">document_note</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (reference)</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (appointment_id)</TD></TR></TABLE>>];
user_account [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>user_account</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(190)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">enum(&#x27;pending&#x27;,&#x27;admin&#x27;,&#x27;manager&#x27;,&#x27;gate&#x27;,&#x27;warehouse&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">tinyint(1)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (email)</TD></TR></TABLE>>];
vehicle [shape=box,style="rounded,dashed",label="Véhicules\nvehicle",color="#a0aab5"];
customer_order -> owner [label="owner_id",taillabel="0..N",headlabel="1",labeldistance=2];
customer_order -> user_account [label="preparer_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
order_line -> customer_order [label="order_id",taillabel="0..N",headlabel="1",labeldistance=2];
order_line -> article [label="article_id",taillabel="0..N",headlabel="1",labeldistance=2];
pick -> order_line [label="order_line_id",taillabel="0..N",headlabel="1",labeldistance=2];
pick -> receipt_item [label="receipt_item_id",taillabel="0..N",headlabel="1",labeldistance=2];
pick -> location [label="location_id",taillabel="0..N",headlabel="1",labeldistance=2];
package -> customer_order [label="order_id",taillabel="0..N",headlabel="1",labeldistance=2];
package_pick -> package [label="package_id",taillabel="0..N",headlabel="1",labeldistance=2];
package_pick -> pick [label="pick_id",taillabel="0..1",headlabel="1",labeldistance=2];
shipment -> customer_order [label="order_id",taillabel="0..1",headlabel="1",labeldistance=2];
shipment -> truck_visit [label="visit_id",taillabel="0..N",headlabel="1",labeldistance=2];
shipment -> user_account [label="actor_id",taillabel="0..N",headlabel="1",labeldistance=2];
receipt_item -> receipt_line [label="line_id",taillabel="0..N",headlabel="1",labeldistance=2];
receipt_item -> lot [label="lot_id",taillabel="0..N",headlabel="1",labeldistance=2];
receipt_item -> location [label="location_id",taillabel="0..N",headlabel="1",labeldistance=2];
location -> rack_level [label="level_id",taillabel="0..N",headlabel="1",labeldistance=2];
truck_visit -> appointment [label="appointment_id",taillabel="0..1",headlabel="0..1",labeldistance=2];
truck_visit -> driver [label="driver_id",taillabel="0..N",headlabel="1",labeldistance=2];
truck_visit -> vehicle [label="vehicle_id",taillabel="0..N",headlabel="1",labeldistance=2];
truck_visit -> vehicle [label="trailer_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
truck_visit -> dock [label="dock_id",taillabel="0..N",headlabel="0..1",labeldistance=2];
}