digraph MLD {
rankdir=LR;
graph [fontname="Arial",bgcolor="white",pad="0.4",nodesep="0.6",ranksep="1",splines=polyline]; node [fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=10,color="#617b94",fontcolor="#17324d"];
carrier [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>carrier</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(190)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
carrier_contact [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>carrier_contact</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK carrier_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(190)</TD><TD>NN</TD></TR></TABLE>>];
carrier_contract [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>carrier_contract</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK carrier_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">reference</TD><TD ALIGN="LEFT">varchar(40)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">starts_on</TD><TD ALIGN="LEFT">date</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ends_on</TD><TD ALIGN="LEFT">date</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">terms</TD><TD ALIGN="LEFT">text</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (reference)</TD></TR></TABLE>>];
driver [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>driver</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK carrier_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">license_number</TD><TD ALIGN="LEFT">varchar(60)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (license_number)</TD></TR></TABLE>>];
driver_qualification [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>driver_qualification</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK driver_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK qualification_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">expires_on</TD><TD ALIGN="LEFT">date</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (driver_id, qualification_id)</TD></TR></TABLE>>];
equipment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>equipment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
qualification [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>qualification</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (code)</TD></TR></TABLE>>];
user_account [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>user_account</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(190)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">enum(&#x27;pending&#x27;,&#x27;admin&#x27;,&#x27;manager&#x27;,&#x27;gate&#x27;,&#x27;warehouse&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">tinyint(1)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (email)</TD></TR></TABLE>>];
vehicle [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>vehicle</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK carrier_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">plate</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">enum(&#x27;tracteur&#x27;,&#x27;remorque&#x27;,&#x27;porteur&#x27;,&#x27;fourgon&#x27;)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">max_kg</TD><TD ALIGN="LEFT">decimal(12,3)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">max_pallets</TD><TD ALIGN="LEFT">decimal(10,3)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (plate)</TD></TR></TABLE>>];
vehicle_equipment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8fa8be"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>vehicle_equipment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK vehicle_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FK equipment_id</TD><TD ALIGN="LEFT">int(11)</TD><TD>NN</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">UNIQUE (vehicle_id, equipment_id)</TD></TR></TABLE>>];
carrier_contact -> carrier [label="carrier_id",taillabel="0..N",headlabel="1",labeldistance=2];
carrier_contract -> carrier [label="carrier_id",taillabel="0..N",headlabel="1",labeldistance=2];
driver -> carrier [label="carrier_id",taillabel="0..N",headlabel="1",labeldistance=2];
driver_qualification -> driver [label="driver_id",taillabel="0..N",headlabel="1",labeldistance=2];
driver_qualification -> qualification [label="qualification_id",taillabel="0..N",headlabel="1",labeldistance=2];
vehicle -> carrier [label="carrier_id",taillabel="0..N",headlabel="1",labeldistance=2];
vehicle_equipment -> vehicle [label="vehicle_id",taillabel="0..N",headlabel="1",labeldistance=2];
vehicle_equipment -> equipment [label="equipment_id",taillabel="0..N",headlabel="1",labeldistance=2];
}