digraph UML {
rankdir=LR;
graph [fontname="Arial",bgcolor="white",pad="0.4",nodesep="0.6",ranksep="1",splines=polyline]; node [fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=10,color="#617b94",fontcolor="#17324d"];
admin [shape=box,label="«actor»\nAdministrateur"];
manager [shape=box,label="«actor»\nResponsable"];
gate [shape=box,label="«actor»\nAccueil"];
warehouse [shape=box,label="«actor»\nMagasinier"];
visitor [shape=box,label="«actor»\nVisiteur"];
subgraph cluster_system { label="Transit - session active requise hors inscription/connexion";color="#6c8aa4";style=rounded;
register [shape=ellipse,label="Demander une inscription",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
auth [shape=ellipse,label="Se connecter / se déconnecter",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
accounts [shape=ellipse,label="Activer et gérer les comptes",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
refs [shape=ellipse,label="Gérer les référentiels",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
reserve [shape=ellipse,label="Planifier les quais",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
flow [shape=ellipse,label="Suivre les étapes des camions",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
receive [shape=ellipse,label="Recevoir, émettre des réserves et clore les avis",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
stock [shape=ellipse,label="Ranger, transférer et ajuster le stock",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
pick [shape=ellipse,label="Préparer FEFO et confirmer les prélèvements",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
ship [shape=ellipse,label="Répartir les colis, charger et imprimer",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
trace [shape=ellipse,label="Tracer les lots",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
report [shape=ellipse,label="Analyser et exporter",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
read [shape=ellipse,label="Consulter le planning et les références",style=filled,fillcolor="#edf4fa",color="#6b8dac"];
}
visitor -> register [dir=none];
visitor -> auth [dir=none];
admin -> accounts [dir=none];
manager -> refs [dir=none];
manager -> report [dir=none];
gate -> auth [dir=none];
gate -> reserve [dir=none];
gate -> flow [dir=none];
gate -> trace [dir=none];
gate -> read [dir=none];
warehouse -> auth [dir=none];
warehouse -> receive [dir=none];
warehouse -> stock [dir=none];
warehouse -> pick [dir=none];
warehouse -> ship [dir=none];
warehouse -> trace [dir=none];
warehouse -> read [dir=none];
admin -> manager [arrowhead=empty,constraint=false];manager -> gate [arrowhead=empty,constraint=false];manager -> warehouse [arrowhead=empty,constraint=false];
}